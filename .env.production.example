# Reference only; enter secret values in the host's secret environment settings.
# Do not copy local .env to a hosting service.
NODE_ENV=production
FRONTEND_URL=https://bracu-bus-management-system.vercel.app
GOOGLE_CALLBACK_URL=https://bracu-bus-management-system.vercel.app/api/auth/google/callback
SESSION_COOKIE_SECURE=true
TRUST_PROXY=true
SESSION_TTL_HOURS=8
DEV_DIRECT_LOGIN=false
DEV_EMAIL_LOGIN=false
ENABLE_DEV_DRIVER_AUTH=false
SESSION_SECRET=
# Neon direct connection string, including its supplied TLS options.
DATABASE_URL=
# PORT is supplied by Render. Google credentials remain unset.
SMTP_HOST=
# Render Free blocks 25/465/587; use a provider supporting STARTTLS on 2525.
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# Three distinct real BRACU inboxes, approved for the indicated demo roles.
DEMO_STUDENT_EMAIL=
DEMO_DRIVER_EMAIL=
DEMO_AUTHORITY_EMAIL=
